# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Server-side only, never expose to client
NEXT_PUBLIC_SITE_URL=https://dungdautu.com


# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=dungdautu-content
R2_PUBLIC_URL=https://cdn.dungdautu.com  # Custom domain CDN trỏ tới R2 bucket

# Revalidation Secret (bảo vệ /api/revalidate)
REVALIDATE_SECRET=change-this-to-a-long-random-secret
